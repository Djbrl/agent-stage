# You don't need this file to use agent-stage.
# Models and their keys live in the app: Settings → Engines & models (saved in ~/.agent-stage/settings.json).
# A key typed there always wins over this file. The server reads this file only when it starts.

# Claude: used by the Claude (Anthropic API) model and the Claude Code engine
# when they have no key in Settings.
ANTHROPIC_API_KEY=

# Any OpenAI-compatible model: NVIDIA, Ollama (http://localhost:11434/v1), vLLM, OpenRouter...
# Read ONCE, on the very first start (when ~/.agent-stage/settings.json doesn't exist yet), to add a
# "From .env" model to Settings. After that, edit the model in Settings instead: changes here are ignored.
# Also used as-is by the terminal agent (`npm run agent`), which has no Settings.
# MODEL_API_KEY=mock switches the app to the scripted demo model (that's what `npm run mock` does).
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# Self-hosted on a remote GPU (see scripts/serve-vllm.sh), for that first-run "From .env" model. Optional.
# The one-click GPU in Settings doesn't need any of these.
# TUNNEL_HOST=agent-gpu          # server keeps an SSH tunnel to this host open and reconnects it
# BREV_INSTANCE=agent-gpu        # show the Brev instance state in the status bar
# GPU_HOURLY_USD=1.06            # GPU price, for the cost meter
