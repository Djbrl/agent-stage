# Any OpenAI-compatible endpoint works: NVIDIA, Ollama (http://localhost:11434/v1), vLLM, OpenRouter...
MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_API_KEY=nvapi-...
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# Self-hosted on a remote GPU (see scripts/serve-vllm.sh). Optional:
# TUNNEL_HOST=agent-gpu          # server keeps an SSH tunnel to this host open and reconnects it
# BREV_INSTANCE=agent-gpu        # show the Brev instance state in the status bar
# GPU_HOURLY_USD=1.06            # GPU price, for the cost meter
