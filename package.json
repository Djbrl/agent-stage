{
  "name": "agent-stage",
  "version": "0.0.1",
  "description": "Visual, lightweight coding agent for open-weight models (temporary name)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "agent": "node --env-file-if-exists=.env src/cli.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && node --env-file-if-exists=.env src/server.ts",
    "web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "d3-hierarchy": "^3.1.2",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
