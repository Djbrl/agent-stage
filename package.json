{
  "name": "agent-stage",
  "version": "0.1.0",
  "description": "The coding-agent harness for learners: a visual coding agent for open-weight models and Claude",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "agent": "node --env-file-if-exists=.env src/cli.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "npm run build && node --env-file-if-exists=.env src/server.ts",
    "web": "vite --config web/vite.config.ts",
    "mock": "npm run build && node --env-file-if-exists=.env scripts/mock.ts",
    "public": "sh scripts/public.sh",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc -p . && tsc -p web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@anthropic-ai/sdk": "^0.134.0",
    "@hono/node-server": "^2.1.5",
    "d3-hierarchy": "^3.1.2",
    "hono": "^4.13.13",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
